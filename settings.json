{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/claude-config-sync",
            "timeout": 10,
            "statusMessage": "Checking global Claude config sync status..."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "padding": 0,
    "command": "~/.local/bin/starship-claude"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "starship-claude@starship-claude": true
  },
  "extraKnownMarketplaces": {
    "daana-modeler": {
      "source": {
        "source": "github",
        "repo": "mattiasthalen/daana-modeler"
      },
      "autoUpdate": true
    },
    "starship-claude": {
      "source": {
        "source": "github",
        "repo": "martinemde/starship-claude"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true
}
